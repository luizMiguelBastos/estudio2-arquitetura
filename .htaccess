# Estúdio2 Arquitetura · configuração para a Hostinger (gerado por tools/gerar_site.py)
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# Sempre HTTPS e sem "www"
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# Links antigos (projeto.html?id=...) para as páginas novas
RewriteCond %{QUERY_STRING} (^|&)id=agnus(&|$)
RewriteRule ^projeto\.html$ /projetos/casa-agnus/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)id=estrela(&|$)
RewriteRule ^projeto\.html$ /projetos/casa-estrela/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)id=vw(&|$)
RewriteRule ^projeto\.html$ /projetos/casa-vw/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)id=lumina(&|$)
RewriteRule ^projeto\.html$ /projetos/casa-lumina/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)id=lima(&|$)
RewriteRule ^projeto\.html$ /projetos/edificio-lima/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)id=aurora(&|$)
RewriteRule ^projeto\.html$ /projetos/casa-aurora/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)id=imperium(&|$)
RewriteRule ^projeto\.html$ /projetos/casa-imperium/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)id=ambar(&|$)
RewriteRule ^projeto\.html$ /projetos/casa-ambar/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)id=solaris(&|$)
RewriteRule ^projeto\.html$ /projetos/casa-solaris/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)id=amity(&|$)
RewriteRule ^projeto\.html$ /projetos/casa-amity/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)id=geminus(&|$)
RewriteRule ^projeto\.html$ /projetos/casa-geminus/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)id=max(&|$)
RewriteRule ^projeto\.html$ /projetos/casa-max/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)id=enlace(&|$)
RewriteRule ^projeto\.html$ /projetos/casa-enlace/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)id=prisma(&|$)
RewriteRule ^projeto\.html$ /projetos/casa-prisma/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)id=vita(&|$)
RewriteRule ^projeto\.html$ /projetos/casa-vita/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)id=vitro(&|$)
RewriteRule ^projeto\.html$ /projetos/casa-vitro/? [R=301,L]

# index.html no endereço vira a pasta (evita conteúdo duplicado)
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]
</IfModule>

# Compressão
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml application/xml text/xml text/plain
</IfModule>

# Cache: imagens por 1 ano; CSS/JS por 1 mês (os links têm ?v=data, então atualizam na hora); HTML sempre conferido
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 year"
ExpiresByType text/css "access plus 1 month"
ExpiresByType application/javascript "access plus 1 month"
ExpiresByType text/javascript "access plus 1 month"
ExpiresByType text/html "access plus 0 seconds"
</IfModule>
<IfModule mod_headers.c>
<FilesMatch "\.(html)$">
Header set Cache-Control "no-cache"
</FilesMatch>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
